{
  "name": "Codex",
  "command": "codex",
  "args": ["--no-daemon", "--sandbox", "workspace-write"],
  "resume": ["resume", "{session}"],
  "prompt": ["{prompt}"],
  "home": {
    "env": "CODEX_HOME",
    "from": "~/.codex",
    "link": ["auth.json"],
    "copy_keys": { "config.toml": ["model", "model_reasoning_effort"] }
  },
  "merge": { "config.toml": "config.toml" },
  "write": { "hooks.json": "hooks.json" },
  "context": "context.md",
  "prompt_context": "prompt.md",
  "login": ["login", "--device-auth"],
  "login_page": "https://auth.openai.com/codex/device",
  "trust": "/hooks",
  "ready": "\u001b]7501;state=idle",
  "usage": "codex-rollout"
}
