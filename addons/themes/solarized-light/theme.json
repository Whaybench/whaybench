{
  "format": 1,
  "name": "Solarized Light",
  "version": "1.0",
  "source": "Colours of Solarized, https://github.com/altercation/solarized (MIT)",
  "palette": {
    "base3": "#fdf6e3", "base2": "#eee8d5", "base1": "#93a1a1", "base01": "#586e75", "base02": "#073642",
    "blue": "#268bd2", "orange": "#cb4b16", "cyan": "#2aa198", "red": "#dc322f", "line": "#e0d9c4"
  },
  "base": { "background": "base3", "surface": "base2", "text": "base01", "accent": "blue" },
