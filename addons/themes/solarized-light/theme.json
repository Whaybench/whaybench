    "joint_width": 2, "joint_show": "always",
    "surface_top": "line", "surface_bottom": "line",
    "panel": "base3",
    "bar_top": "base2", "bar_bottom": "base2",
    "front_top": "base3", "front_bottom": "base3",
    "border": "line", "front_border": "blue",
    "tab_front": "base3",
    "shadow": "#586e7533",
