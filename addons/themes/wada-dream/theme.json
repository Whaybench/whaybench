{
  "format": 1,
  "name": "Wada Dream",
  "version": "1.0",
  "source": "Colours from Sanzo Wada's A Dictionary of Color Combinations (1933-34), combination 176, as digitised in https://github.com/mattdesl/dictionary-of-colour-combinations (MIT); the other shades are mixed from those colours",
