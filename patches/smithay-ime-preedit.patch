+    /// Put the text being composed into the active text input, before it is left: what the input
+    /// method commits on losing the focus comes too late for it.
+    fn commit_preedit(&mut self) {
+        let Some(text) = self.preedit.take() else { return };
+        self.with_active_text_input(|text_input, _, serial| {
+            text_input.preedit_string(None, 0, 0);
+            text_input.commit_string(Some(text.clone()));
+            text_input.done(serial);
+        });
+    }
